{
  "name": "kitchen-sink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#modules/*": "./app/modules/*",
    "#middleware/*": "./app/middleware/*",
    "#config/*": "./config/*",
    "#exceptions/*": "./app/exceptions/*",
    "#start/*": "./start/*"
  },
  "scripts": {
    "dev": "ream dev",
    "start": "ream start",
    "console": "node --import @swc-node/register/esm-register bin/console.ts",
    "atlas:check": "node --import @swc-node/register/esm-register bin/console.ts atlas:check",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr resources/ssr.tsx --outDir public/build/ssr",
    "build:front": "pnpm build:client && pnpm build:ssr",
    "test": "node --import @swc-node/register/esm-register bin/test.ts",
    "build": "ream build"
  },
  "dependencies": {
    "@c9up/archive": "workspace:*",
    "@c9up/atlas": "workspace:*",
    "@c9up/atom": "workspace:*",
    "@c9up/aurora": "workspace:*",
    "@c9up/bay": "workspace:*",
    "@c9up/blackhole": "workspace:*",
    "@c9up/chronos": "workspace:*",
    "@c9up/comet": "workspace:*",
    "@c9up/echo": "workspace:*",
    "@c9up/eclipse": "workspace:*",
    "@c9up/eon": "workspace:*",
    "@c9up/inker": "workspace:*",
    "@c9up/nebula": "workspace:*",
    "@c9up/nova": "workspace:*",
    "@c9up/parsec": "workspace:*",
    "@c9up/photon": "workspace:*",
    "@c9up/prism": "workspace:*",
    "@c9up/quasar": "workspace:*",
    "@c9up/ream": "workspace:*",
    "@c9up/relay": "workspace:*",
    "@c9up/rosetta": "workspace:*",
    "@c9up/rover": "workspace:*",
    "@c9up/rune": "workspace:*",
    "@c9up/sigil": "workspace:*",
    "@c9up/spectrum": "workspace:*",
    "@c9up/station": "workspace:*",
    "@c9up/transit": "workspace:*",
    "@c9up/vellum": "workspace:*",
    "@c9up/warden": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "svelte": "^5.57.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@c9up/helix": "workspace:*",
    "@c9up/helix-plugin-ream": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@swc-node/register": "^1.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "hotHook": {
    "boundaries": [
      "./app/middleware/*.ts",
      "./app/modules/*/controllers/*.ts",
      "./app/modules/*/middleware/*.ts"
    ]
  },
  "//engines": "Node 24, not 22, because AsyncLocalStorage sits on the request hot path — the container resolves through it, HttpContext is it, and the emitter reads it on every event. Node 24 backs it with AsyncContextFrame by default, and measured on that exact pattern (one context per request, six async boundaries, several reads) it costs 0.61 us per request instead of 1.55 us: 2.5x, on every request, for free. Before 24 the same mechanism existed only behind an experimental flag, and a framework cannot base its performance on a flag the application has to remember to pass. This is NOT 'track the current LTS' — security fixes still land in 22 until 2027, npm 11 is irrelevant under pnpm, and node:sqlite is not what atlas uses.",
  "engines": {
    "node": ">=24.0.0"
  }
}
